generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SALES_STAFF
  FIELD_STAFF
  CUSTOMER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum InventoryTransactionType {
  IN
  OUT
  ADJUSTMENT
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum OrderSource {
  ONLINE
  POS
}

enum PaymentMethod {
  COD
  CASH
  BANK_TRANSFER
  SANDBOX_GATEWAY
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
}

enum CourtOperationalStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  TEMPORARILY_LOCKED
}

enum CourtBookingStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum CourtBookingSource {
  ONLINE
  OFFLINE
}

enum CourtBookingCheckoutStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

enum BookingGroupStatus {
  RECRUITING
  FULL
  PLAYING
  COMPLETED
  CANCELLED
}

enum GroupMemberRole {
  OWNER
  MEMBER
}

enum GroupMemberStatus {
  JOINED
  LEFT
}

model User {
  id                     String                     @id @default(uuid()) @db.Uuid
  fullName               String                     @map("full_name") @db.VarChar(120)
  email                  String                     @unique @db.VarChar(255)
  phone                  String?                    @db.VarChar(20)
  defaultAddress         String?                    @map("default_address") @db.Text
  passwordHash           String                     @map("password_hash")
  role                   UserRole                   @default(CUSTOMER)
  isActive               Boolean                    @default(true) @map("is_active")
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart                   Cart?
  sessions               UserSession[]
  courtStaffAssignments  CourtStaffAssignment[]     @relation("AssignmentStaff")
  orders                 Order[]                    @relation("OrderCustomer")
  ordersCreated          Order[]                    @relation("OrderCreator")
  ordersPaymentConfirmed Order[]                    @relation("OrderPaymentConfirmer")
  courtLocksCreated      CourtLock[]                @relation("CourtLockCreator")
  courtLocksReleased     CourtLock[]                @relation("CourtLockReleaser")
  courtBookings          CourtBooking[]             @relation("BookingCustomer")
  createdBookings        CourtBooking[]             @relation("BookingCreator")
  bookingsPaymentConfirmed CourtBooking[]           @relation("BookingPaymentConfirmer")
  bookingGroups          CourtBookingGroup[]        @relation("GroupOwner")
  groupMembers           CourtBookingGroupMember[]
  chatbotSessions        ChatbotSession[]
  bookingCheckouts       CourtBookingCheckout[]

  @@index([role, isActive])
  @@map("users")
}

model UserSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash") @db.Text
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent       String?   @map("user_agent") @db.Text
  ipAddress       String?   @map("ip_address") @db.VarChar(45)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt      DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Cart {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id               String  @id @default(uuid()) @db.Uuid
  cartId           String  @map("cart_id") @db.Uuid
  productVariantId String  @map("product_variant_id") @db.Uuid
  quantity         Int
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart           Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([cartId, productVariantId])
  @@index([productVariantId])
  @@map("cart_items")
}

model CourtStaffAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  courtId      String    @map("court_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  unassignedAt DateTime?  @map("unassigned_at") @db.Timestamptz(3)

  user User @relation("AssignmentStaff", fields: [userId], references: [id], onDelete: Restrict)
  court Court @relation(fields: [courtId], references: [id], onDelete: Restrict)

  @@index([userId, assignedAt])
  @@index([courtId, assignedAt, unassignedAt])
  @@map("court_staff_assignments")
}

model Sport {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(150)
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  categories Category[]
  products   Product[]
  courts     Court[]

  @@index([isActive])
  @@map("sports")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  sportId     String    @map("sport_id") @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @db.VarChar(150)
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sport    Sport       @relation(fields: [sportId], references: [id], onDelete: Restrict)
  parent   Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]  @relation("CategoryHierarchy")
  products Product[]

  @@unique([sportId, slug])
  @@unique([id, sportId]) 
  @@index([parentId])
  @@index([sportId, isActive, sortOrder])
  @@map("categories")
}

model Product {
  id                 String                     @id @default(uuid()) @db.Uuid
  sportId            String                     @map("sport_id") @db.Uuid
  categoryId         String                     @map("category_id") @db.Uuid
  name               String                     @db.VarChar(255)
  slug               String                     @unique @db.VarChar(255)
  shortDescription   String?                    @map("short_description")
  description        String?
  specs              Json?                      @db.JsonB
  status             ProductStatus              @default(DRAFT)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sport              Sport                      @relation(fields: [sportId], references: [id], onDelete: Restrict)
  category           Category                   @relation(fields: [categoryId, sportId], references: [id, sportId], onDelete: Restrict)
  images             ProductImage[]
  variants           ProductVariant[]
  orderItems         OrderItem[]
  chatbotRecommendations ChatbotMessageRecommendation[] @relation("RecommendationProduct")

  @@index([sportId, categoryId, status])
  @@map("products")
}

model ProductImage {
  id         String    @id @default(uuid()) @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  url        String    @db.Text
  publicId   String    @unique @map("public_id") @db.VarChar(255)
  altText    String?   @map("alt_text") @db.VarChar(255)
  sortOrder  Int       @default(0) @map("sort_order")
  isPrimary  Boolean   @default(false) @map("is_primary")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductVariant {
  id                 String    @id @default(uuid()) @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  sku                String    @unique @db.VarChar(100)
  name               String?   @db.VarChar(255)
  attributes         Json?     @db.JsonB
  price              Decimal   @db.Decimal(12, 2)
  originalPrice      Decimal?  @map("original_price") @db.Decimal(12, 2)
  stockQuantity      Int       @default(0) @map("stock_quantity")
  lowStockThreshold  Int?      @map("low_stock_threshold")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product              Product                        @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryTransactions InventoryTransaction[]
  orderItems           OrderItem[]
  cartItems            CartItem[]
  chatbotRecommendations ChatbotMessageRecommendation[] @relation("RecommendationVariant")

  @@unique([id, productId])
  @@index([productId, isActive])
  @@index([stockQuantity])
  @@map("product_variants")
}

model InventoryTransaction {
  id                String                     @id @default(uuid()) @db.Uuid
  productVariantId  String                     @map("product_variant_id") @db.Uuid
  type              InventoryTransactionType
  quantity          Int
  stockBefore       Int                        @map("stock_before")
  stockAfter        Int                        @map("stock_after")
  reason            String                     @db.VarChar(255)
  referenceType     String?                    @map("reference_type") @db.VarChar(100)
  referenceId       String?                    @map("reference_id") @db.Uuid
  note              String?
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([productVariantId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

model Order {
  id                        String                     @id @default(uuid()) @db.Uuid
  orderCode                 String                     @unique @map("order_code") @db.VarChar(50)
  userId                    String?                    @map("user_id") @db.Uuid
  createdByUserId           String?                    @map("created_by_user_id") @db.Uuid
  customerName              String                     @map("customer_name") @db.VarChar(120)
  customerEmail             String?                    @map("customer_email") @db.VarChar(255)
  phone                     String                     @db.VarChar(20)
  address                   String?                    @db.Text
  note                      String?                    @db.Text
  paymentMethod             PaymentMethod              @map("payment_method")
  paymentStatus             PaymentStatus              @default(UNPAID) @map("payment_status")
  paymentTransactionId      String?                    @map("payment_transaction_id") @db.VarChar(255)
  paymentCheckoutUrl        String?                    @map("payment_checkout_url") @db.Text
  paymentIdempotencyKey      String?                    @unique @map("payment_idempotency_key") @db.VarChar(160)
  guestCancelTokenHash       String?                    @unique @map("guest_cancel_token_hash") @db.VarChar(255)
  guestCancelTokenExpiresAt  DateTime?                  @map("guest_cancel_token_expires_at") @db.Timestamptz(3)
  guestCancelTokenUsedAt     DateTime?                  @map("guest_cancel_token_used_at") @db.Timestamptz(3)
  paymentExpiresAt          DateTime?                  @map("payment_expires_at") @db.Timestamptz(3)
  paymentPaidAt             DateTime?                  @map("payment_paid_at") @db.Timestamptz(3)
  paymentConfirmedById      String?                    @map("payment_confirmed_by_id") @db.Uuid
  status                    OrderStatus                @default(PENDING_CONFIRMATION)
  source                    OrderSource                @default(ONLINE)
  totalAmount               Decimal                    @map("total_amount") @db.Decimal(12, 2)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User?   @relation("OrderCustomer", fields: [userId], references: [id], onDelete: SetNull)
  createdBy         User?   @relation("OrderCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  paymentConfirmer  User?   @relation("OrderPaymentConfirmer", fields: [paymentConfirmedById], references: [id], onDelete: SetNull)
  items             OrderItem[]

  @@index([userId, createdAt])
  @@index([phone])
  @@index([source, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, paymentExpiresAt])
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(uuid()) @db.Uuid
  orderId           String  @map("order_id") @db.Uuid
  productId         String  @map("product_id") @db.Uuid
  productVariantId  String  @map("product_variant_id") @db.Uuid
  productName       String  @map("product_name") @db.VarChar(255)
  variantName       String? @map("variant_name") @db.VarChar(255)
  sku               String  @db.VarChar(100)
  unitPrice         Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity          Int
  lineTotal         Decimal @map("line_total") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant    ProductVariant    @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
  @@map("order_items")
}

model Court {
  id           String                  @id @default(uuid()) @db.Uuid
  sportId      String                  @map("sport_id") @db.Uuid
  name         String                  @db.VarChar(120)
  slug         String                  @unique @db.VarChar(150)
  location     String?                 @db.VarChar(255)
  pricePerHour Decimal                 @map("price_per_hour") @db.Decimal(12, 2)
  status       CourtOperationalStatus  @default(AVAILABLE)
  isActive     Boolean                 @default(true) @map("is_active")
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  sport        Sport                   @relation(fields: [sportId], references: [id], onDelete: Restrict)
  assignments  CourtStaffAssignment[]
  locks        CourtLock[]
  bookings     CourtBooking[]
  holds        CourtBookingHold[]

  @@index([sportId, isActive, status])
  @@map("courts")
}

model CourtLock {
  id           String    @id @default(uuid()) @db.Uuid
  courtId      String    @map("court_id") @db.Uuid
  createdById  String    @map("created_by") @db.Uuid
  reason       String    @db.Text
  lockedAt     DateTime  @default(now()) @map("locked_at") @db.Timestamptz(3)
  releasedAt   DateTime? @map("released_at") @db.Timestamptz(3)
  releasedById String?   @map("released_by") @db.Uuid

  court        Court  @relation(fields: [courtId], references: [id], onDelete: Restrict)
  createdBy    User   @relation("CourtLockCreator", fields: [createdById], references: [id], onDelete: Restrict)
  releasedBy   User?  @relation("CourtLockReleaser", fields: [releasedById], references: [id], onDelete: Restrict)

  @@index([courtId, lockedAt])
  @@index([courtId, releasedAt])
  @@map("court_locks")
}

model CourtBookingGroup {
  id              String              @id @default(uuid()) @db.Uuid
  groupCode       String              @unique @map("group_code") @db.VarChar(50)
  ownerUserId     String              @map("owner_user_id") @db.Uuid
  checkoutId      String?             @unique @map("checkout_id") @db.Uuid
  title           String              @db.VarChar(255)
  description     String?             @db.Text
  bookingDate     DateTime            @map("booking_date") @db.Date
  startTime       DateTime            @map("start_time") @db.Time(0)
  endTime         DateTime            @map("end_time") @db.Time(0)
  requiredMembers Int                 @map("required_members")
  currentMembers  Int                 @default(1) @map("current_members")
  status          BookingGroupStatus  @default(RECRUITING)
  expiresAt              DateTime?           @map("expires_at") @db.Timestamptz(3)
  slotAmount      Decimal             @map("slot_amount") @db.Decimal(12, 2)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner           User                      @relation("GroupOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  checkout        CourtBookingCheckout?      @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  bookings        CourtBooking[]
  members         CourtBookingGroupMember[]

  @@index([ownerUserId, createdAt])
  @@index([status, bookingDate, startTime])
  @@map("court_booking_groups")
}

// ✅ Đã cập nhật: xóa @@unique([groupId, userId]) theo hướng dẫn
model CourtBookingGroupMember {
  id                     String              @id @default(uuid()) @db.Uuid
  groupId                String              @map("group_id") @db.Uuid
  userId                 String              @map("user_id") @db.Uuid
  role                   GroupMemberRole     @default(MEMBER)
  status                 GroupMemberStatus   @default(JOINED)
  assignedCourtBookingId String?            @map("assigned_court_booking_id") @db.Uuid
  joinedAt               DateTime            @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt                 DateTime?           @map("left_at") @db.Timestamptz(3)

  group                  CourtBookingGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user                   User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedCourtBooking   CourtBooking?      @relation(fields: [assignedCourtBookingId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([assignedCourtBookingId])
  @@map("court_booking_group_members")
}

model CourtBooking {
  id                     String              @id @default(uuid()) @db.Uuid
  bookingCode            String              @unique @map("booking_code") @db.VarChar(50)
  courtId                String              @map("court_id") @db.Uuid
  userId                 String?             @map("user_id") @db.Uuid
  groupId                String?             @map("group_id") @db.Uuid
  checkoutId             String?             @map("checkout_id") @db.Uuid 
  customerName           String              @map("customer_name") @db.VarChar(120)
  customerPhone          String              @map("customer_phone") @db.VarChar(20)
  bookingDate            DateTime            @map("booking_date") @db.Date
  startTime              DateTime            @map("start_time") @db.Time(0)
  endTime                DateTime            @map("end_time") @db.Time(0)
  totalAmount            Decimal             @map("total_amount") @db.Decimal(12, 2)
  source                 CourtBookingSource
  status                 CourtBookingStatus  @default(PENDING_CONFIRMATION)
  expiresAt              DateTime?           @map("expires_at") @db.Timestamptz(3)
  note                   String?             @db.Text
  paymentMethod          PaymentMethod       @default(CASH) @map("payment_method") 
  paymentStatus          PaymentStatus       @default(UNPAID) @map("payment_status") 
  paymentTransactionId   String?             @map("payment_transaction_id") @db.VarChar(255)
  paymentPaidAt          DateTime?           @map("payment_paid_at") @db.Timestamptz(3)
  paymentConfirmedById   String?             @map("payment_confirmed_by_id") @db.Uuid
  createdByUserId        String?             @map("created_by_user_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  court              Court                    @relation(fields: [courtId], references: [id], onDelete: Restrict)
  user               User?                    @relation("BookingCustomer", fields: [userId], references: [id], onDelete: SetNull)
  group              CourtBookingGroup?        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy          User?                    @relation("BookingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  paymentConfirmer   User?                    @relation("BookingPaymentConfirmer", fields: [paymentConfirmedById], references: [id], onDelete: SetNull)
  groupMembers       CourtBookingGroupMember[]

  @@unique([id, groupId]) 
  @@index([courtId, bookingDate, startTime, endTime])
  @@index([userId, createdAt])
  @@index([status, bookingDate])
  @@index([groupId])
  @@index([paymentStatus, paymentPaidAt])
  @@map("court_bookings")
}

model CourtBookingCheckout {
  id                     String                        @id @default(uuid()) @db.Uuid
  checkoutCode           String                        @unique @map("checkout_code") @db.VarChar(50)
  userId                 String                        @map("user_id") @db.Uuid
  customerName           String                        @map("customer_name") @db.VarChar(120)
  customerPhone          String                        @map("customer_phone") @db.VarChar(20)
  status                 CourtBookingCheckoutStatus    @default(PENDING)
  totalAmount            Decimal                       @map("total_amount") @db.Decimal(12, 2)
  providerTransactionId  String?                       @map("provider_transaction_id") @db.VarChar(255)
  checkoutUrl            String?                       @map("checkout_url") @db.Text
  idempotencyKey         String                        @unique @map("idempotency_key") @db.VarChar(160)
  expiresAt              DateTime                      @map("expires_at") @db.Timestamptz(3)
  paidAt                 DateTime?                     @map("paid_at") @db.Timestamptz(3)
  createdAt              DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  holds          CourtBookingHold[]
  bookingGroup   CourtBookingGroup?

  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@index([providerTransactionId])
  @@map("court_booking_checkouts")
}

model CourtBookingHold {
  id           String    @id @default(uuid()) @db.Uuid
  checkoutId   String    @map("checkout_id") @db.Uuid
  courtId      String    @map("court_id") @db.Uuid
  bookingDate  DateTime  @map("booking_date") @db.Date
  startTime    DateTime  @map("start_time") @db.Time(0)
  endTime      DateTime  @map("end_time") @db.Time(0)
  unitPrice    Decimal   @map("unit_price") @db.Decimal(12, 2)
  amount       Decimal   @db.Decimal(12, 2)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  checkout CourtBookingCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  court    Court                @relation(fields: [courtId], references: [id], onDelete: Restrict)

  @@index([courtId, bookingDate, startTime, endTime])
  @@index([checkoutId])
  @@index([expiresAt])
  @@map("court_booking_holds")
}

model ChatbotSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages  ChatbotMessage[]

  @@index([userId, updatedAt])
  @@map("chatbot_sessions")
}

model ChatbotMessage {
  id          String    @id @default(uuid()) @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  modelUsed   String    @map("model_used") @db.VarChar(50)
  userMessage String    @map("user_message") @db.Text
  botResponse String    @map("bot_response") @db.Text
  tokenCount  Int?      @map("token_count")
  isHelpful   Boolean?  @map("is_helpful")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session          ChatbotSession                  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  recommendations  ChatbotMessageRecommendation[]

  @@index([sessionId, createdAt])
  @@map("chatbot_messages")
}

model ChatbotMessageRecommendation {
  id                      String   @id @default(uuid()) @db.Uuid
  messageId               String   @map("message_id") @db.Uuid
  productId               String   @map("product_id") @db.Uuid
  productVariantId        String?  @map("product_variant_id") @db.Uuid
  recommendationOrder     Int      @map("recommendation_order")
  snapshotProductName     String   @map("snapshot_product_name") @db.VarChar(255)
  snapshotVariantName     String?  @map("snapshot_variant_name") @db.VarChar(255)
  snapshotSku             String?  @map("snapshot_sku") @db.VarChar(100)
  snapshotPrice           Decimal? @map("snapshot_price") @db.Decimal(12, 2)
  snapshotProductStatus   String   @map("snapshot_product_status") @db.VarChar(50)
  snapshotVariantIsActive Boolean? @map("snapshot_variant_is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message          ChatbotMessage  @relation(fields: [messageId], references: [id], onDelete: Restrict)
  product          Product         @relation("RecommendationProduct", fields: [productId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant? @relation("RecommendationVariant", fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([messageId, recommendationOrder])
  // Partial unique indexes & composite FK cho product/variant sẽ thêm trong file SQL
  @@index([productId, createdAt])
  @@index([productVariantId])
  @@map("chatbot_message_recommendations")
}

